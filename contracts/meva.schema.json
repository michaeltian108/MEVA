      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "goal",
        "non_goals",
        "risk_tier",
        "risk_rationale",
        "data_classification",
        "physical_safety_tier",
        "target_environments",
        "extensions"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "goal": {"$ref": "#/$defs/nonEmptyString"},
        "non_goals": {"$ref": "#/$defs/stringArray"},
        "risk_tier": {"$ref": "#/$defs/riskTier"},
        "risk_rationale": {"$ref": "#/$defs/nonEmptyString"},
        "data_classification": {"$ref": "#/$defs/dataClassification"},
        "physical_safety_tier": {"$ref": "#/$defs/physicalSafetyTier"},
        "target_environments": {
          "type": "array",
          "items": {"$ref": "#/$defs/environment"},
          "minItems": 1,
          "uniqueItems": true
        },
        "extensions": {"$ref": "#/$defs/extensions"}
      }
    },
    "stateRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "status", "current_invalidation_revision", "updated_at", "history"],
      "properties": {
        "revision": {"type": "integer", "minimum": 0},
        "status": {"$ref": "#/$defs/lifecycleState"},
        "current_invalidation_revision": {"type": "integer", "minimum": 0},
        "updated_at": {"$ref": "#/$defs/timestamp"},
        "history": {
          "type": "array",
          "items": {"$ref": "#/$defs/stateTransition"}
        }
      }
    },
    "projectState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version",
        "schema_uri",
        "project",
        "state",
        "authority",
        "requirements",
        "interfaces",
        "decisions",
        "tasks",
        "gates",
        "artifacts",
        "evidence",
        "findings",
        "review",
        "approvals",
        "accounting",
        "permission_attestations",
        "invalidations",
        "persistent_resources",
        "provenance",
        "extensions"
      ],
      "properties": {
        "contract_version": {"$ref": "#/$defs/contractVersion"},
        "schema_uri": {"const": "contracts/meva.schema.json"},
        "project": {"$ref": "#/$defs/project"},
        "state": {"$ref": "#/$defs/stateRecord"},
        "authority": {"$ref": "#/$defs/authority"},
        "requirements": {
          "type": "array",
          "items": {"$ref": "#/$defs/requirement"}
        },
        "interfaces": {
          "type": "array",
          "items": {"$ref": "#/$defs/interface"}
        },
        "decisions": {
          "type": "array",
          "items": {"$ref": "#/$defs/decision"}
        },
        "tasks": {
          "type": "array",
          "items": {"$ref": "#/$defs/task"}
        },
        "gates": {
          "type": "array",
          "items": {"$ref": "#/$defs/gateRecord"}
        },
        "artifacts": {
          "type": "array",
          "items": {"$ref": "#/$defs/artifact"}
        },
        "evidence": {
          "type": "array",
          "items": {"$ref": "#/$defs/evidence"}
        },
        "findings": {
          "type": "array",
          "items": {"$ref": "#/$defs/finding"}
        },
        "review": {"$ref": "#/$defs/review"},
        "approvals": {
          "type": "array",
          "items": {"$ref": "#/$defs/approval"}
        },
        "accounting": {"$ref": "#/$defs/accounting"},
        "permission_attestations": {
          "type": "array",
          "items": {"$ref": "#/$defs/permissionAttestation"}
        },
        "invalidations": {
          "type": "array",
          "items": {"$ref": "#/$defs/invalidation"}
        },
        "persistent_resources": {
          "type": "array",
          "items": {"$ref": "#/$defs/persistentResource"}
        },
        "action_ledger": {"$ref": "#/$defs/actionLedger"},
        "provenance": {"$ref": "#/$defs/provenance"},
        "extensions": {"$ref": "#/$defs/extensions"}
      }
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["severity", "issue", "mitigation", "owner"],
      "properties": {
        "severity": {"$ref": "#/$defs/severity"},
        "issue": {"$ref": "#/$defs/nonEmptyString"},
        "mitigation": {"$ref": "#/$defs/nonEmptyString"},
