    "nextAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "action", "acceptance_criteria"],
      "properties": {
        "owner": {"type": "string", "minLength": 1},
        "action": {"$ref": "#/$defs/nonEmptyString"},
        "acceptance_criteria": {"$ref": "#/$defs/stringArray"}
      }
    },
    "handoffGateResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gate", "result", "evidence_ids"],
      "properties": {
        "gate": {"$ref": "#/$defs/gate"},
        "result": {"$ref": "#/$defs/gateResult"},
        "evidence_ids": {"$ref": "#/$defs/idArray"}
      }
    },
    "handoffEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "claim", "source", "environment", "result", "observation"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "claim": {"$ref": "#/$defs/nonEmptyString"},
        "source": {"$ref": "#/$defs/nonEmptyString"},
        "environment": {"$ref": "#/$defs/environment"},
        "result": {"$ref": "#/$defs/evidenceResult"},
        "observation": {"type": "string"}
      }
    },
    "handoffApproval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "approval_id",
        "approved_by",
        "action",
        "scope",
        "environment",
        "limits",
        "expires_at",
        "reason",
        "verification_source",
        "verification_status"
      ],
      "properties": {
        "required": {"type": "boolean"},
        "approval_id": {"type": "string"},
        "approved_by": {"type": "string"},
        "action": {"type": "string"},
        "scope": {"$ref": "#/$defs/stringArray"},
        "environment": {"type": "string"},
        "limits": {"type": "object", "additionalProperties": true},
        "expires_at": {"type": "string"},
        "reason": {"type": "string"},
        "verification_source": {"type": "string"},
        "verification_status": {"type": "string"}
      }
    },
    "legacyHandoff": {
      "description": "Compatibility-only full handoff record; never accepted by validate-handoff.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version",
        "task_id",
        "role",
        "status",
        "summary",
        "scope",
        "provenance",
        "decisions",
        "evidence",
        "risks",
        "open_questions",
        "next_actions",
        "human_approval",
        "extensions"
      ],
      "properties": {
        "contract_version": {"$ref": "#/$defs/contractVersion"},
        "task_id": {"$ref": "#/$defs/identifier"},
        "role": {"$ref": "#/$defs/role"},
        "status": {"$ref": "#/$defs/handoffStatus"},
        "summary": {"$ref": "#/$defs/nonEmptyString"},
        "scope": {"$ref": "#/$defs/scope"},
        "provenance": {"$ref": "#/$defs/provenance"},
        "project": {
          "type": "object",
          "additionalProperties": false,
          "required": ["risk_tier", "state", "state_revision", "delivered", "excluded"],
          "properties": {
            "risk_tier": {"$ref": "#/$defs/riskTier"},
            "state": {"$ref": "#/$defs/lifecycleState"},
            "state_revision": {"type": "string", "minLength": 1},
            "delivered": {"$ref": "#/$defs/stringArray"},
            "excluded": {"$ref": "#/$defs/stringArray"}
          }
        },
        "gate_results": {
          "type": "array",
          "items": {"$ref": "#/$defs/handoffGateResult"}
        },
        "decisions": {
          "type": "array",
          "items": {"$ref": "#/$defs/decision"}
        },
        "evidence": {
          "type": "array",
          "items": {"$ref": "#/$defs/handoffEvidence"}
        },
        "risks": {
          "type": "array",
          "items": {"$ref": "#/$defs/risk"}
        },
        "open_questions": {"$ref": "#/$defs/stringArray"},
        "next_actions": {
          "type": "array",
          "items": {"$ref": "#/$defs/nextAction"}
        },
        "human_approval": {"$ref": "#/$defs/handoffApproval"},
        "extensions": {"$ref": "#/$defs/extensions"}
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "role": {"const": "meva_orchestrator"}
            },
            "required": ["role"]
          },
          "then": {
            "required": ["project", "gate_results"]
          },
          "else": {
            "not": {
              "anyOf": [
                {"required": ["project"]},
                {"required": ["gate_results"]}
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "role": {"enum": ["planner", "reviewer"]}
            },
            "required": ["role"]
          },
          "then": {
            "properties": {
              "scope": {
                "properties": {
                  "changed": {"maxItems": 0}
                }
              }
            }
          }
        }
      ]
    },
    "compactHandoff": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version",
        "task_id",
        "role",
        "status",
        "summary",
        "changed",
        "refs"
      ],
      "properties": {
        "contract_version": {"$ref": "#/$defs/contractVersion"},
        "task_id": {"$ref": "#/$defs/handoffTaskId"},
        "role": {"$ref": "#/$defs/role"},
        "status": {"$ref": "#/$defs/handoffStatus"},
        "summary": {"$ref": "#/$defs/handoffText"},
        "changed": {"$ref": "#/$defs/handoffItems"},
        "refs": {"$ref": "#/$defs/handoffItems"},
        "open": {
          "type": "string",
          "maxLength": 240
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {"const": "complete"}
            },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "open": {"maxLength": 0}
            }
          },
          "else": {
            "required": ["open"],
            "properties": {
              "open": {"minLength": 1}
            }
          }
        },
        {
          "if": {
            "properties": {
              "role": {"enum": ["planner", "reviewer"]}
            },
            "required": ["role"]
          },
          "then": {
            "properties": {
              "changed": {"maxItems": 0}
            }
          }
        }
      ]
    },
    "handoff": {
      "description": "Compact envelope for new cross-phase and crosmeva coordination; legacy records are retained only for migration.",
      "oneOf": [
        {"$ref": "#/$defs/compactHandoff"},
        {"$ref": "#/$defs/legacyHandoff"}
      ]
    }
  }
}
