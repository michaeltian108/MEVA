        "changed_ids": {"$ref": "#/$defs/idArray"},
        "affected_artifact_ids": {"$ref": "#/$defs/idArray"},
        "affected_evidence_ids": {"$ref": "#/$defs/idArray"},
        "affected_gate_ids": {"$ref": "#/$defs/idArray"},
        "required_owners": {"$ref": "#/$defs/stringArray"},
